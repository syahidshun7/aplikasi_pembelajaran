APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=belajar_laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_VERIFY_SSL=true

AI_PRIMARY=gemini
AI_FALLBACK=ollama
AI_TIMEOUT_MS=15000
AI_RETRY_COUNT=1
AI_MASKING_ENABLED=true
AI_VERIFY_SSL=true
AI_ARTIFACT_MAX_CHARS=12000
AI_PDF_EXTRACTION_ENABLED=true
AI_PREPROCESS_WITH_OLLAMA=false
AI_AUTO_APPLY_MIN_CONFIDENCE=65
AI_QA_DETECTOR_USE_AI=true
AI_QA_DETECTOR_MAX_CHARS=12000
AI_QA_DETECTOR_MERGE_INTO_ADVISOR=true
AI_EXTRACTION_PYTHON_BINARY=python
AI_EXTRACTION_SCRIPT_PATH=scripts/submission_extractor.py
AI_EXTRACTION_MAX_CHARS=200000
AI_EXTRACTION_OCR_TIMEOUT_SECONDS=60
AI_EXTRACTION_TESSERACT_BINARY=tesseract
AI_EXTRACTION_PDFTOPPM_BINARY=pdftoppm
AI_CLEANING_PYTHON_BINARY=python
AI_CLEANING_SCRIPT_PATH=scripts/submission_cleaner.py
AI_CLEANING_MAX_CHARS=200000
AI_CLEANING_TIMEOUT_SECONDS=30
AI_STRUCTURE_PYTHON_BINARY=python
AI_STRUCTURE_SCRIPT_PATH=scripts/submission_structure_detector.py
AI_STRUCTURE_MAX_CHARS=200000
AI_STRUCTURE_TIMEOUT_SECONDS=30
AI_SEMANTIC_PYTHON_BINARY=python
AI_SEMANTIC_SCRIPT_PATH=scripts/submission_semantic_enricher.py
AI_SEMANTIC_MAX_ITEMS=500
AI_SEMANTIC_TIMEOUT_SECONDS=30
AI_RUBRIC_PYTHON_BINARY=python
AI_RUBRIC_SCRIPT_PATH=scripts/submission_rubric_preparer.py
AI_RUBRIC_MAX_ITEMS=500
AI_RUBRIC_ALLOWED_FEEDBACK_LENGTH=200
AI_RUBRIC_TIMEOUT_SECONDS=30
AI_EVALUATION_PYTHON_BINARY=python
AI_EVALUATION_SCRIPT_PATH=scripts/submission_ai_evaluator.py
AI_EVALUATION_MAX_ITEMS=500
AI_EVALUATION_TIMEOUT_SECONDS=30
AI_POST_EVAL_PYTHON_BINARY=python
AI_POST_EVAL_SCRIPT_PATH=scripts/submission_post_evaluation_validator.py
AI_POST_EVAL_MAX_ITEMS=500
AI_POST_EVAL_TIMEOUT_SECONDS=30
AI_POST_EVAL_MAX_RETRIES=2
AI_RESULT_PRES_PYTHON_BINARY=python
AI_RESULT_PRES_SCRIPT_PATH=scripts/submission_result_presenter.py
AI_RESULT_PRES_MAX_ITEMS=500
AI_RESULT_PRES_TIMEOUT_SECONDS=30

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b

VITE_APP_NAME="${APP_NAME}"
VITE_CHAT_SERVER_URL=
VITE_CHAT_SOCKET_PATH=/socket.io
