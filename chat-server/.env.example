# Chat server bind
PORT=3001
HOST=0.0.0.0
SOCKET_PATH=/socket.io

# Allowed frontend origins (comma separated)
# Example:
# CORS_ORIGIN=https://dooptech.my.id,https://www.dooptech.my.id
CORS_ORIGIN=*

# MySQL (can reuse Laravel DB)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=belajar_laravel
DB_USER=root
DB_PASS=

# Redis connection (choose ONE mode)
# Mode A: TCP host/port
REDIS_URL=redis://127.0.0.1:6379

# Mode B: UNIX socket (cPanel Redis Manager)
# REDIS_SOCKET=/home/username/redis.sock

# Optional auth/db
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DB=0
